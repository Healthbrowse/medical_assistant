PORT=8080
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Used only by licensed terminology operators.
UMLS_API_KEY=
SNOMED_CT_LICENSE_CONFIRMED=false

# Server runtime. Install the actual token as a secret with permission to make
# calls to Hugging Face Inference Providers. Leave all real tokens out of Git.
MODEL_PROVIDER=deepseek
HF_TOKEN=
# Exact checkpoint IDs. Omitting these overrides uses the same defaults.
DEEPSEEK_GENERAL_MODEL=deepseek-ai/DeepSeek-R1-Distill-Llama-8B
DEEPSEEK_CLINICIAN_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
# The research planner is fixed to deepseek-ai/DeepSeek-V3.2.
# Set RETRIEVAL_LIVE=off for a local test limited to bundled sources.

# Optional automatic failover for DeepSeek generation, review and planning.
# MODEL_FALLBACK_PROVIDER=groq
# Supply GROQ_API_KEY as a separate server runtime secret.

# Optional legacy provider. Set MODEL_PROVIDER=groq to select it explicitly.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=

# Optional legacy dedicated endpoints. Set MODEL_PROVIDER=custom to select them.
# MODEL_GENERAL_URL=https://router.huggingface.co/v1/chat/completions
# MODEL_GENERAL_ID=meta-llama/Meta-Llama-3-8B-Instruct:featherless-ai
# MODEL_GENERAL_KEY=
# MODEL_GENERAL_CONTEXT_TOKENS=8192
# MODEL_PROFESSIONAL_URL=https://dr7.ai/api/v1/medical/chat/completions
# MODEL_PROFESSIONAL_ID=medgemma-4b-it
# MODEL_PROFESSIONAL_KEY=
